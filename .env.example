# OmniMind Archive — Local Configuration
LOCAL_ONLY=true
FORCE_INGEST=false
RUN_LOCAL_EXTRACTOR=true

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
QUANTIZE_LEVEL=none
QUANTIZE_CACHE_DIR=.cache/embeddings

VECTOR_DB=chroma
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION=omnimind_v1
ALLOW_INMEMORY_VECTORS=true

BM25_TOP_K=50
VECTOR_TOP_K=50
RRF_K=60
ALPHA_VECTOR=1.5
ALPHA_BM25=1.0
FINAL_TOP_K=10

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_PCT=0.10
FORCE_NEWLINE_CHUNK=true
FALLBACK_CHUNK_CHARS=2048

REDACT_LEVEL=min
REDACT_EMAILS=true
REDACT_PHONES=true
REDACT_SSNS=true
REDACT_CREDIT_CARDS=true
REDACT_API_KEYS=true

DATA_DIR=.data
CHECKPOINT_DIR=.data/checkpoints
FAILED_EXPORTS_DIR=.data/failed_exports
MAX_UPLOAD_SIZE_MB=500
RETENTION_DAYS=90
PURGE_ENABLED=false

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_LOG_LEVEL=info
STREAMLIT_SERVER_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

RATE_LIMIT_INGEST_PER_HOUR=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_QUERY_PER_MINUTE=20

RETRY_MAX_ATTEMPTS=5
MEMORY_WARNING_THRESHOLD_PCT=80

ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_STRUCTURED_LOGGING=true
LOG_REDACT_SECRETS=true

SECRET_KEY=
API_KEY=change-me
AUTH_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
CORS_ENABLED=true

REDIS_URL=
QUEUE_BACKEND=memory
QUEUE_NAME=omnimind-ingest
SENTRY_DSN=

OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
